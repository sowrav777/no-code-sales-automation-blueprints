{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "No-Code Sales Automation Blueprint",
  "type": "object",
  "required": [
    "id",
    "name",
    "goal",
    "best_for",
    "required_inputs",
    "trigger",
    "workflow_steps",
    "manual_tests",
    "handoff_instructions"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "goal": { "type": "string" },
    "best_for": { "type": "array", "items": { "type": "string" } },
    "required_inputs": { "type": "array", "items": { "type": "string" } },
    "trigger": { "type": "object" },
    "workflow_steps": { "type": "array", "items": { "type": "object" } },
    "manual_tests": { "type": "array", "items": { "type": "object" } },
    "handoff_instructions": { "type": "array", "items": { "type": "string" } }
  }
}
